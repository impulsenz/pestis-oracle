# Pestis on Oracle Cloud - your settings. Copy this file to /opt/pestis/pestis.env and fill it in:
#   sudo mkdir -p /opt/pestis && sudo cp setup/pestis.env.example /opt/pestis/pestis.env && sudo nano /opt/pestis/pestis.env
# Keep the quotes. Nothing in here goes to GitHub.

# 1. The web address of your server (no https://, no slash), e.g. pestis-acme.duckdns.org
PESTIS_DOMAIN="pestis-yourname.duckdns.org"

# 2. An email address for the security certificate (Let's Encrypt sends expiry warnings here)
CERT_EMAIL="you@example.com"

# 3. Your own email: you become the first admin when you sign in with Google using it
ADMIN_EMAIL="you@gmail.com"

# 4. Google sign-in (Google Cloud console > APIs & Services > Credentials > your OAuth client)
GOOGLE_CLIENT_ID="1234567890-xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxx"

# 5. Email for the clients' "Email me a sign-in link" (leave SMTP_HOST empty to skip for now;
#    clients can still sign in with Google). Gmail: smtp.gmail.com, port 587, your Gmail address,
#    and an App Password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER_NAME="Pesties"
SMTP_ADMIN_EMAIL=""          # the "from" address, usually the same as SMTP_USER

# 6. Where the apps come from (this repository). Leave as is unless you renamed it.
APP_REPO="git@github.com:impulsenz/pestis-oracle.git"

# 7. How long to keep the nightly database backups (days)
BACKUP_DAYS="14"
